{
  "ConnectionStrings": {
   "DefaultConnection": "Server=.;Database=BlogSystem;Trusted_Connection =true;TrustServerCertificate=true;MultipleActiveResultSets=true"
  },

  "Logging": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Information"
      },
      "WriteTo": [
        {
          "Name": "Console",
          "Args": {
            "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} <s:{SourceContext}> <id:{RequestId}>{NewLine}{Exception}"
          }
        },
        {
          "Name": "File",
          "Args": {
            "path": "Logs/log-.txt",
            "rollingInterval": "Day",
            "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} <s:{SourceContext}> <id:{RequestId}>{NewLine}{Exception}"
          }
        },
        {
          "Name": "Debug"
        }
      ]
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://localhost:7185/",
    "Audience": "http://localhost:7185/",
    "Key": "StRoNGAuTheNTICatHioNKeYStRoNGAuTheNTICatHioNKeY",
    "DurationInDays": "2"

  },
  "EmailSettings": {
    "From": "no-reply-myBlog@gmail.com",
    "DisplayName": "MyBlog Team",
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "yourmail@example.com",
    "Password": "yourAppPassword"
  }

}
